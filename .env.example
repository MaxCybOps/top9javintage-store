# Public site URL (used for SEO, sitemap, and payment callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Real business WhatsApp number, international format, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional studio protection. If STUDIO_PASSWORD is set, /studio and mutating
# studio APIs require login. Leave blank for an open demo workspace.
STUDIO_PASSWORD=
# Recommended when auth is enabled; otherwise derived from the password.
STUDIO_SESSION_SECRET=

# Live payments activate only when the matching secret key is present.
# Use test keys first. Never expose secret keys to the browser.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# Required for Flutterwave webhook verification (set in Flutterwave dashboard).
FLUTTERWAVE_WEBHOOK_HASH=
